# Copy to .env and fill in values before running docker compose
# docker compose automatically loads .env from the same directory

# Optional: global bearer token that all robots must send.
# If empty, all robots are accepted (unless overridden per-competition).
REPORT_AUTH=

# TCP port exposed on the host (only used if you add a ports: mapping
# to docker-compose.yaml for local testing without Traefik).
# SERVER_PORT=5000
